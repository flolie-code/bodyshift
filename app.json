{
  "expo": {
    "name": "BodyShift",
    "slug": "bodyshift-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bodyshift",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#143A3F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bodyshift.companion",
      "infoPlist": {
        "NSCameraUsageDescription": "BodyShift verwendet die Kamera, um deine Mahlzeiten per KI zu analysieren und Barcodes zu scannen.",
        "NSMicrophoneUsageDescription": "BodyShift verwendet das Mikrofon für die Spracheingabe deiner Mahlzeiten.",
        "NSPhotoLibraryUsageDescription": "BodyShift greift auf deine Fotos zu, damit du Vorher/Nachher-Bilder deines Fortschritts speichern kannst."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#143A3F"
      },
      "package": "com.bodyshift.companion",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "BodyShift verwendet die Kamera für KI-Mahlzeit-Analyse und Barcode-Scans."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "46fda740-d8bd-4209-b42a-fd2c3f15b0a2"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "flolie"
  }
}
