---
import Bar from '../components/Bar.astro';
import Base from '../layouts/Base.astro';
import { products, site } from '../data/site';
const cats = [...new Set(products.map((p) => p.category))];
const wa = (p: string) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hallo Reformbar-Team! Ich interessiere mich für: ${p}`)}`;
const schema = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Reformbar Shop',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name })),
}];
---
<Base
  title="Shop – Yogamatten, Zubehör & Protein | Reformbar Feldbach"
  description="Der Reformbar Shop in Feldbach: Yogamatten, Yoga-Blöcke, Eiweißpulver, Grip-Socken, Trinkflaschen und Gutscheine – direkt im Studio erhältlich."
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow" style="opacity:.75;margin-bottom:22px">Shop</p>
      <h1 class="display">Alles für dein<br />Training an der <Bar class="ib" /></h1>
      <p class="lead sh-lead">Ausgewählte Produkte für Studio und Zuhause – direkt bei uns in Feldbach erhältlich. Unser Sortiment wächst gerade, schau bald wieder vorbei.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="filters" role="tablist" aria-label="Kategorien">
        <button type="button" class="on" data-cat="alle" aria-pressed="true">Alle</button>
        {cats.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
      </div>
      <div class="grid">
        {products.map((p, i) => (
          <article class="prod" data-reveal data-tilt data-c={p.category} style={`--d:${(i % 3) * 0.07}s`} id={p.slug}>
            <div class="pic">
              <img src={p.image} alt={p.name} width="800" height="800" loading="lazy" />
              <span class={`badge ${p.status}`}>{p.status === 'bald' ? 'Bald im Studio' : 'Im Studio erhältlich'}</span>
            </div>
            <div class="body">
              <span class="cat">{p.category}</span>
              <h2 class="display">{p.name}</h2>
              <p>{p.text}</p>
              <div class="foot">
                <span class="price">{p.price}</span>
                <a class="pill" href={wa(p.name)} target="_blank" rel="noopener">Anfragen <span class="arr">→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="note" data-reveal>
        <h2 class="display">So kommst du zu deinem Produkt</h2>
        <p>Alle Produkte bekommst du direkt bei uns im Studio in der {site.street}, {site.zip} {site.city}. Du möchtest etwas reservieren oder hast eine Frage? Schreib uns per WhatsApp, ruf an unter <a href={`tel:${site.phoneHref}`}>{site.phone}</a> oder per Mail an <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const items = document.querySelectorAll<HTMLElement>('.prod');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    const c = b.dataset.cat;
    items.forEach((it) => { it.hidden = !(c === 'alle' || it.dataset.c === c); });
  }));
</script>

<style>
  .sh-lead { max-width: 560px; margin-top: 26px; opacity: 0.9; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(24px, 3vw, 40px); }
  .filters button { padding: 11px 18px; border-radius: 99px; background: #fff; font-size: 14px; font-weight: 600; color: var(--blue); transition: 0.25s var(--ease); }
  .filters button:hover { background: var(--sand); }
  .filters button.on { background: var(--blue); color: #fff; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .prod { background: #fff; border-radius: 26px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), opacity 0.9s var(--ease); }
  .prod[hidden] { display: none; }
  .prod:hover { box-shadow: 0 30px 60px -30px rgba(16, 28, 133, 0.45); }
  .pic { position: relative; aspect-ratio: 1; background: var(--cream); overflow: hidden; }
  .pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .prod:hover .pic img { transform: scale(1.05); }
  .badge { position: absolute; top: 14px; left: 14px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 7px 12px; border-radius: 99px; background: rgba(255, 255, 255, 0.92); color: var(--blue); }
  .badge.verfuegbar { background: var(--blue); color: #fff; }
  .body { padding: 22px 24px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .cat { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; color: var(--mute); }
  .body h2 { font-size: 24px; letter-spacing: -0.03em; color: var(--ink); }
  .body p { font-size: 14.5px; color: var(--mute); line-height: 1.55; }
  .foot { margin-top: auto; padding-top: 14px; display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid rgba(22, 23, 28, 0.08); }
  .price { font-family: var(--display); font-weight: 800; color: var(--blue); font-size: 15px; letter-spacing: -0.01em; }
  .prod:hover .pill .arr { transform: translateX(4px); }
  .note { margin-top: clamp(40px, 5vw, 64px); background: var(--blue); color: #fff; border-radius: 26px; padding: clamp(26px, 4vw, 44px); }
  .note h2 { font-size: clamp(24px, 2.6vw, 34px); margin-bottom: 12px; }
  .note p { opacity: 0.9; max-width: 720px; }
  .note a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; gap: 12px; } }
</style>
