---
import Base from '../layouts/Base.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Reviews from '../components/Reviews.astro';
import Bar from '../components/Bar.astro';
import Gallery from '../components/Gallery.astro';
import { services, site } from '../data/site';
const marquee = ['Reformer Pilates', 'Bodyforming', 'Yoga', 'Matten-Pilates', 'Beckenboden', '1:1 Coaching'];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'de-AT' },
];
---
<Base
  title="Reformbar Feldbach – Reformer Pilates, Bodyforming & Yoga"
  description="Reformbar ist das Boutique Studio in Feldbach für Reformer Pilates, Bodyforming, Yoga, Matten-Pilates, Beckenbodentraining und 1:1 Coaching. Jetzt Termin buchen."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-in">
      <h1 class="display hero-h" aria-label="Alles ist reformbar.">
        <span class="line" aria-hidden="true"><span class="mask"><span>ALLES IST</span></span></span>
        <span class="line l2" aria-hidden="true"><span class="mask"><span>REFORM</span></span><Bar /></span>
      </h1>
      <div class="hero-bottom">
        <div class="hero-sub">
          <p class="lead">Das Boutique Studio in Feldbach für Reformer Pilates, Bodyforming &amp; Yoga. Kleine Gruppen. Großer Unterschied.</p>
          <div class="hero-btns">
            <a href="/buchen/" class="btn white" data-magnetic>Termin buchen <span class="arr">→</span></a>
            <a href="#angebot" class="btn line-w">Angebot entdecken</a>
          </div>
        </div>
        <div class="hero-pics">
          <div class="arch a1 wide"><img data-parallax="60" src="/img/hero-reformer.webp" alt="Frau und Mann beim Reformer Pilates im hellen Studio der Reformbar Feldbach" width="1800" height="1357" fetchpriority="high" /></div>
        </div>
      </div>
    </div>
  </section>

  <p class="opening"><span class="dot" aria-hidden="true"></span>{site.opening} · Pakete schon jetzt als Weihnachtsgeschenk sichern – <a href="/kontakt/">anfragen</a></p>

  <div class="marq" aria-hidden="true" data-marq>
    <div class="marq-in">
      {[0, 1].map(() => marquee.map((m) => (<><span>{m}</span><i class="script">bar</i></>)))}
    </div>
  </div>

  <section class="section" id="angebot" aria-labelledby="ang-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display h2" id="ang-h" data-reveal>Dein Programm<br />an der <span class="script">bar</span></h2>
        <p class="lead sec-lead" data-reveal style="--d:.1s">Sechs Angebote, ein Anspruch: Training, das wirkt – und sich dabei gut anfühlt. Wähle, was dich heute bewegt.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <section class="about" aria-labelledby="about-h">
    <div class="wrap about-in">
      <div class="about-pics">
        <div class="arch"><img data-parallax="40" src="/img/reception.webp" alt="Empfang der Reformbar mit königsblauem Logo" loading="lazy" width="1256" height="1104" /></div>
        <div class="badge" aria-hidden="true">
          <svg viewBox="0 0 120 120"><defs><path id="circ" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs><text><textPath href="#circ">BOUTIQUE STUDIO · FELDBACH · REFORMBAR · </textPath></text></svg>
        </div>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Das sind wir</p>
        <h2 class="display h2" id="about-h" data-reveal>Klein. Persönlich.<br />Ganz bei <span class="script">dir.</span></h2>
        <p class="lead" data-reveal>Die Reformbar ist kein Fitnessstudio von der Stange. Bei uns trainierst du in kleinen Gruppen, in einem Raum, der Ruhe ausstrahlt – und mit Menschen, die deinen Namen kennen. Unser Anspruch: Du gehst besser raus, als du reingekommen bist.</p>
        <ul class="facts" data-reveal>
          <li><strong>6</strong><span>Angebote unter einem Dach</span></li>
          <li><strong>1:1</strong><span>Betreuung, wenn du sie willst</span></li>
          <li><strong>100&nbsp;%</strong><span>Boutique statt Masse</span></li>
        </ul>
        <a href="/das-sind-wir/" class="btn" data-reveal data-magnetic>Mehr über uns <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <section class="section steps" aria-labelledby="steps-h">
    <div class="wrap">
      <h2 class="display h2" id="steps-h" data-reveal>In drei Schritten<br />an die <span class="script">bar</span></h2>
      <ol class="step-list">
        <li data-reveal><span class="display">01</span><h3>Angebot wählen</h3><p>Reformer, Bodyforming, Yoga oder doch 1:1? Such dir aus, was zu dir passt.</p></li>
        <li data-reveal style="--d:.1s"><span class="display">02</span><h3>Wunschtermin anfragen</h3><p>Tag im Kalender auswählen, Zeitfenster angeben, abschicken – in unter einer Minute.</p></li>
        <li data-reveal style="--d:.2s"><span class="display">03</span><h3>Ankommen &amp; loslegen</h3><p>Wir bestätigen deinen Termin persönlich. Du bringst nur dich selbst mit.</p></li>
      </ol>
    </div>
  </section>

  <Gallery />

  <Reviews />

  <section class="cta" aria-labelledby="cta-h">
    <div class="wrap cta-in">
      <h2 class="display" id="cta-h" data-reveal>Bereit für deine<br />erste <span class="script">Einheit?</span></h2>
      <div class="cta-btns" data-reveal style="--d:.1s">
        {services.filter((s) => s.calendar).map((s) => (
          <a href={`/buchen/?angebot=${s.slug}`} class="btn" data-magnetic>{s.name} buchen <span class="arr">→</span></a>
        ))}
        <a href="/kontakt/" class="btn line">Frage stellen</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Laufband reagiert auf die Scroll-Richtung
  const m = document.querySelector<HTMLElement>('[data-marq]');
  if (m) {
    let last = window.scrollY;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (Math.abs(y - last) > 4) m.classList.toggle('rev', y < last);
      last = y;
    }, { passive: true });
  }
</script>

<style>
  .hero { background: var(--blue); color: #fff; min-height: 100svh; display: flex; padding-top: clamp(96px, 9vw, 130px); overflow: hidden; }
  .hero-in { display: flex; flex-direction: column; justify-content: space-between; width: 100%; }
  .hero-h { font-size: clamp(58px, 16.2vw, 250px); line-height: 0.84; letter-spacing: -0.05em; }
  .line { display: block; position: relative; }
  .mask { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .mask > span { display: inline-block; animation: rise 1.1s var(--ease) both; }
  .l2 .mask > span { animation-delay: 0.12s; }
  .hero-h :global(.bar-svg) { position: absolute; left: 3.12em; top: 0.24em; height: 1.3em; width: auto; color: var(--champ); animation: write 1.3s 0.75s var(--ease) both; z-index: 3; pointer-events: none; }
  @keyframes rise { from { transform: translateY(110%); } }
  @keyframes write { from { clip-path: inset(0 100% 0 0); opacity: 0; } to { clip-path: inset(0 0 0 0); opacity: 1; } }

  .hero-bottom { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-top: clamp(24px, 3vw, 40px); }
  .hero-sub { max-width: 440px; padding-bottom: clamp(40px, 6vw, 84px); animation: fade 1s 0.9s var(--ease) both; }
  .hero-sub p { opacity: 0.9; margin-bottom: 28px; }
  .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  @keyframes fade { from { opacity: 0; transform: translateY(20px); } }
  .hero-pics { display: flex; align-items: flex-end; gap: 14px; animation: fade 1.2s 0.5s var(--ease) both; position: relative; z-index: 2; }
  .arch { overflow: hidden; border-radius: 999px 999px 0 0; background: var(--blue-d); }
  .arch img { width: 100%; height: 118%; object-fit: cover; will-change: transform; }
  .hero-pics .a1 { width: clamp(220px, 30vw, 440px); height: clamp(250px, 33vw, 470px); }
  .hero-pics .a2 { width: clamp(110px, 13vw, 190px); height: clamp(140px, 17vw, 240px); }
  .hero-pics .a1.wide { width: clamp(340px, 46vw, 680px); height: clamp(260px, 33vw, 480px); border-radius: 999px 999px 0 0 / 70% 70% 0 0; }
  .hero-pics .a1.wide img { object-position: 50% 60%; }

  .opening { background: var(--blue-d); color: #fff; text-align: center; font-size: 13.5px; padding: 12px var(--pad); display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; }
  .opening a { text-decoration: underline; text-underline-offset: 3px; color: var(--champ); }
  .opening .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--champ); animation: pulseC 2s infinite; }
  @keyframes pulseC { 0% { box-shadow: 0 0 0 0 rgba(248,225,197,.7); } 100% { box-shadow: 0 0 0 9px rgba(248,225,197,0); } }
  .marq { background: var(--cream); color: var(--blue); overflow: hidden; padding: clamp(14px, 1.6vw, 22px) 0; border-bottom: 1px solid rgba(22, 23, 28, 0.08); }
  .marq-in { display: flex; align-items: center; width: max-content; animation: marq 38s linear infinite; font-family: var(--display); font-weight: 800; font-size: clamp(20px, 2.2vw, 32px); letter-spacing: -0.02em; text-transform: uppercase; white-space: nowrap; }
  .marq.rev .marq-in { animation-direction: reverse; }
  .marq span { margin: 0 clamp(16px, 2vw, 28px); }
  .marq .script { font-size: 1.7em; text-transform: none; transform: rotate(-5deg); }
  @keyframes marq { to { transform: translateX(-50%); } }

  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: clamp(32px, 4vw, 52px); flex-wrap: wrap; }
  .sec-lead { max-width: 360px; color: var(--mute); }

  .about { background: #fbf8f3; padding: clamp(72px, 9vw, 130px) 0; }
  .about-in { display: grid; grid-template-columns: 0.85fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .about-pics { position: relative; max-width: 480px; }
  .about-pics .arch { aspect-ratio: 4 / 5; }
  .badge { position: absolute; right: -44px; bottom: 40px; width: 130px; height: 130px; border-radius: 50%; background: var(--blue); animation: spin 22s linear infinite; }
  .badge text { fill: #fff; font-size: 10.6px; font-weight: 600; letter-spacing: 0.21em; font-family: 'Inter Variable', sans-serif; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .about .eyebrow { color: var(--blue); margin-bottom: 18px; }
  .about .h2 { margin-bottom: 26px; }
  .about .lead { color: #3d3a35; max-width: 540px; }
  .facts { list-style: none; display: flex; gap: clamp(20px, 3vw, 44px); margin: 34px 0 38px; flex-wrap: wrap; }
  .facts strong { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(30px, 3vw, 42px); letter-spacing: -0.04em; color: var(--blue); line-height: 1.1; }
  .facts span { font-size: 13px; color: var(--mute); }

  .step-list { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: clamp(32px, 4vw, 52px); }
  .step-list li { background: #fff; border-radius: 26px; padding: 30px; }
  .step-list span { font-size: 54px; color: var(--blue); display: block; margin-bottom: 26px; }
  .step-list h3 { font-family: var(--display); font-weight: 800; letter-spacing: -0.03em; font-size: 22px; margin-bottom: 8px; }
  .step-list p { color: var(--mute); font-size: 15px; }

  .cta { padding: clamp(80px, 11vw, 150px) 0; text-align: center; }
  .cta h2 { font-size: clamp(40px, 8vw, 120px); color: var(--blue); }
  .cta h2 .script { font-size: 1.6em; transform: rotate(-5deg) translateY(0.1em); }
  .cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: clamp(40px, 5vw, 64px); }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-bottom { flex-direction: column; align-items: stretch; margin-top: 68px; gap: 36px; }
    .hero-sub { padding-bottom: 0; }
    .hero-pics { justify-content: flex-end; }
    .hero-pics .a1 { width: 62vw; height: 66vw; } .hero-pics .a2 { width: 28vw; height: 36vw; }
    .hero-pics .a1.wide { width: 100%; height: 66vw; }
    .about-in { grid-template-columns: 1fr; }
    .about-pics { max-width: 78%; } .badge { right: -36px; width: 104px; height: 104px; }
    .step-list { grid-template-columns: 1fr; gap: 12px; }
    .cta-btns .btn { width: 100%; }
  }
</style>
