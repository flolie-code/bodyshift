---
import Legal from '../layouts/Legal.astro';
import { site } from '../data/site';
const c = site.company;
---
<Legal title="Impressum | Reformbar Feldbach" description="Impressum der Reformbar – ein Studio der Body Shift FLB GmbH." heading="Impressum">
  <p>Informationspflicht laut § 5 E-Commerce-Gesetz, § 14 Unternehmensgesetzbuch, § 63 Gewerbeordnung und Offenlegungspflicht laut § 25 Mediengesetz.</p>

  <h2>Medieninhaber und Betreiber</h2>
  <p>
    <strong>{c.name}</strong><br />
    {c.street}<br />{c.zip} {c.city}<br />{c.country}
  </p>
  <p>
    Telefon: <a href={`tel:${site.phoneHref}`}>{site.phone}</a><br />
    E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
  <p>„Reformbar“ ist ein Studio der {c.name} am Standort {site.zip} {site.city}.</p>

  <h2>Unternehmensdaten</h2>
  <dl>
    <dt>Vollständiger Firmenname</dt><dd>{c.name}</dd>
    <dt>Rechtsform</dt><dd>Gesellschaft mit beschränkter Haftung (GmbH)</dd>
    <dt>Geschäftsführer</dt><dd>{c.ceo}</dd>
    <dt>Sitz / Ort der Gewerbeberechtigung</dt><dd>{c.street}, {c.zip} {c.city}, {c.country}</dd>
    <dt>UID-Nummer</dt><dd>{c.uid}</dd>
    <dt>Firmenbuchnummer</dt><dd>{c.fn}</dd>
    <dt>Unternehmensgegenstand</dt><dd>{c.purpose}</dd>
    <dt>Kammerzugehörigkeit</dt><dd>{c.chamber}</dd>
    <dt>Aufsichtsbehörde</dt><dd>{c.authority}</dd>
    <dt>Anwendbare Vorschriften</dt><dd>Gewerbeordnung 1994, abrufbar unter <a href="https://www.ris.bka.gv.at" rel="noopener" target="_blank">www.ris.bka.gv.at</a></dd>
  </dl>

  <h2>Blattlinie</h2>
  <p>Diese Website informiert über das Angebot und die Leistungen des Studios Reformbar in Feldbach.</p>

  <h2>Haftungsausschluss</h2>
