---
import { services } from '../data/site';
const [first, ...rest] = services;
const last = rest.pop()!;
const tones = ['blue', 'white', 'sand', 'white'];
---
<div class="cards">
  <article class="card photo" data-reveal data-tilt>
    <img src={first.image} alt="Frau beim Reformer Pilates im hellen Studio der Reformbar Feldbach" loading="lazy" width="1200" height="1500" />
    <div class="c-top"><span class="num">01</span><span class="live">Online anfragbar</span></div>
    <div>
      <h3 class="display big"><a href={`/${first.slug}/`}>Reformer<br />Pilates</a></h3>
      <p>{first.short}</p>
      <a class="pill inv" href={`/buchen/?angebot=${first.slug}`}>Kalender öffnen <span class="arr">→</span></a>
    </div>
  </article>
  {rest.map((s, i) => (
    <article class={`card ${tones[i]}`} data-reveal data-tilt style={`--d:${(i + 1) * 0.07}s`}>
      <div class="c-top"><span class="num">0{i + 2}</span>{s.calendar && <span class="live">Online anfragbar</span>}</div>
      <div>
        <h3 class="display"><a href={`/${s.slug}/`}>{s.name}</a></h3>
        <p>{s.short}</p>
      </div>
      <a class={`pill ${tones[i] === 'blue' ? 'inv' : ''}`} href={`/buchen/?angebot=${s.slug}`}>{s.calendar ? 'Kalender öffnen' : 'Termin anfragen'} <span class="arr">→</span></a>
    </article>
  ))}
  <article class="card blue wide" data-reveal>
    <div>
      <span class="num">06</span>
      <h3 class="display"><a href={`/${last.slug}/`}>{last.name} – deine Einheit, dein Tempo.</a></h3>
    </div>
    <a class="pill inv" href={`/buchen/?angebot=${last.slug}`}>Termin anfragen <span class="arr">→</span></a>
  </article>
</div>

<style>
  .cards { display: grid; grid-template-columns: 1.35fr 1fr 1fr; grid-auto-rows: minmax(290px, auto); gap: 18px; }
  .card { border-radius: 26px; padding: 28px; position: relative; overflow: hidden; background: #fff; display: flex; flex-direction: column; justify-content: space-between; gap: 20px; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), opacity 0.9s var(--ease); transform-style: preserve-3d; }
  .card:hover { box-shadow: 0 30px 60px -30px rgba(16, 28, 133, 0.45); }
  .card:hover .pill .arr { transform: translateX(5px); }
  .card h3 { font-size: clamp(26px, 2.3vw, 32px); line-height: 1; }
  .card h3.big { font-size: clamp(40px, 4.2vw, 58px); }
  .card h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card p { font-size: 14.5px; line-height: 1.55; opacity: 0.78; max-width: 300px; margin-top: 10px; }
  .card .pill { position: relative; z-index: 2; align-self: flex-start; }
  .card .pill:hover { transform: scale(1.05); }
  .pill.inv { background: #fff; color: var(--blue); }
  .c-top { display: flex; justify-content: space-between; align-items: center; position: relative; }
  .num { font-size: 11px; letter-spacing: 0.2em; opacity: 0.65; font-weight: 600; }
  .live { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; gap: 8px; align-items: center; }
  .live::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.7); } 100% { box-shadow: 0 0 0 9px rgba(61, 220, 132, 0); } }
  .card.blue { background: var(--blue); color: #fff; }
  .card.sand { background: var(--sand); }
  .card.photo { grid-row: span 2; color: #fff; }
  .card.photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1.2s var(--ease); }
  .card.photo:hover img { transform: scale(1.06); }
  .card.photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16, 28, 133, 0.25) 0%, rgba(16, 28, 133, 0.05) 35%, rgba(16, 28, 133, 0.88) 100%); }
  .card.photo > div { position: relative; z-index: 2; }
  .card.photo h3 a::after { z-index: 1; }
  .card.photo .pill { margin-top: 20px; }
  .card.wide { grid-column: 1 / -1; grid-row: auto; min-height: 0; flex-direction: row; align-items: center; }
  .card.wide h3 { font-size: clamp(24px, 3vw, 42px); margin-top: 8px; }
  .card.wide .pill { align-self: center; flex: none; }
  @media (max-width: 1000px) {
    .cards { grid-template-columns: 1fr 1fr; }
    .card.photo { grid-column: 1 / -1; grid-row: auto; min-height: 440px; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; grid-auto-rows: auto; gap: 12px; }
    .card { min-height: 230px; padding: 24px; }
    .card.wide { flex-direction: column; align-items: flex-start; }
    .card.wide .pill { align-self: flex-start; }
  }
</style>
