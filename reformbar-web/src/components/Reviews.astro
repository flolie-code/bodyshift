---
import { reviews } from '../data/site';
// Dreifach gerendert, damit das Band endlos durchlaufen kann
const loop = [...reviews, ...reviews, ...reviews];
---
<section class="rev" id="stimmen" aria-labelledby="rev-h">
  <div class="wrap">
    <div class="rev-head">
      <h2 class="display rev-title" id="rev-h" data-reveal>Was unsere<br />Kund:innen <span class="script">sagen.</span></h2>
      <div class="rev-meta" data-reveal style="--d:.1s">
        <div class="rev-stars" aria-label="5 von 5 Sternen">★★★★★</div>
        <p>{reviews.length} echte Google-Bewertungen<br />unserer Kund:innen</p>
        <div class="rev-ctrl">
          <button type="button" data-rev-prev aria-label="Vorherige Bewertungen">←</button>
          <button type="button" data-rev-next aria-label="Nächste Bewertungen">→</button>
        </div>
      </div>
    </div>
  </div>
  <div class="rev-track" data-rev-track tabindex="0" aria-label="Kundenbewertungen – wischen zum Blättern">
    {loop.map((r, i) => (
      <figure class="rev-card" aria-hidden={i < reviews.length || i >= reviews.length * 2 ? 'true' : undefined}>
        <div class="rev-top">
          <span class="rev-av" aria-hidden="true">{r.name.charAt(0)}</span>
          <figcaption>
            <strong>{r.name}</strong>
            <span>Google-Bewertung</span>
          </figcaption>
          <svg class="rev-g" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21.35 11.1H12v2.9h5.35c-.5 2.45-2.6 3.85-5.35 3.85A5.85 5.85 0 1 1 12 6.15c1.5 0 2.85.55 3.9 1.45l2.15-2.15A8.9 8.9 0 0 0 12 3.1a8.9 8.9 0 1 0 0 17.8c5.15 0 8.55-3.6 8.55-8.7 0-.4-.05-.75-.2-1.1Z"/></svg>
        </div>
        <div class="rev-stars sm" aria-label="5 von 5 Sternen">★★★★★</div>
        <blockquote>{r.text}</blockquote>
      </figure>
    ))}
  </div>
  <p class="wrap rev-note">Individuelle Erfahrungen – Ergebnisse können von Person zu Person variieren.</p>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-rev-track]');
  if (track) {
    const cards = track.querySelectorAll<HTMLElement>('.rev-card');
    const n = cards.length / 3;
    const step = () => cards[1].offsetLeft - cards[0].offsetLeft;
    const setW = () => step() * n;
    const jump = (x: number) => { track.style.scrollBehavior = 'auto'; track.style.scrollSnapType = 'none'; track.scrollLeft = x; track.style.scrollBehavior = ''; track.style.scrollSnapType = ''; };
    const init = () => jump(setW());
    init();
    window.addEventListener('resize', init);

    // Endlos: unbemerkt in den mittleren Satz zurückspringen, sobald das Scrollen stoppt
    let t: number;
    track.addEventListener('scroll', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const w = setW();
        if (track.scrollLeft < w * 0.5) jump(track.scrollLeft + w);
        else if (track.scrollLeft >= w * 1.5) jump(track.scrollLeft - w);
      }, 140);
    }, { passive: true });

    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    document.querySelector('[data-rev-prev]')?.addEventListener('click', () => { go(-1); rest(); });
    document.querySelector('[data-rev-next]')?.addEventListener('click', () => { go(1); rest(); });

    // Automatisches Durchlaufen – pausiert bei Interaktion
    let timer: number | undefined;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const play = () => { if (!calm && !timer) timer = window.setInterval(() => go(1), 4200); };
    const stop = () => { clearInterval(timer); timer = undefined; };
    const rest = () => { stop(); play(); };
    ['pointerenter', 'touchstart', 'focusin'].forEach((e) => track.addEventListener(e, stop, { passive: true }));
    ['pointerleave', 'touchend', 'focusout'].forEach((e) => track.addEventListener(e, play, { passive: true }));
    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : stop()), { threshold: 0.3 }).observe(track);

    // Ziehen mit der Maus
    let down = false, sx = 0, sl = 0, moved = false;
    track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = track.scrollLeft; });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 4) { moved = true; track.classList.add('drag'); }
      if (moved) track.scrollLeft = sl - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!down) return; down = false;
      if (moved) { track.classList.remove('drag'); const s = step(); track.scrollTo({ left: Math.round(track.scrollLeft / s) * s, behavior: 'smooth' }); }
    });
  }
</script>

<style>
  .rev { background: var(--blue); color: #fff; padding: clamp(72px, 9vw, 120px) 0; overflow: hidden; }
  .rev-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: clamp(32px, 4vw, 52px); flex-wrap: wrap; }
  .rev-title { font-size: clamp(36px, 5vw, 72px); }
  .rev-title .script { color: var(--cream); font-size: 1.7em; transform: rotate(-5deg) translateY(0.12em); }
  .rev-meta { text-align: right; font-size: 13px; opacity: 0.95; }
  .rev-meta p { opacity: 0.75; margin: 6px 0 16px; line-height: 1.5; }
  .rev-stars { color: #ffc93c; letter-spacing: 3px; font-size: 20px; }
  .rev-stars.sm { font-size: 15px; margin: 18px 0 12px; }
  .rev-ctrl { display: inline-flex; gap: 8px; }
  .rev-ctrl button { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.45); font-size: 17px; transition: 0.3s var(--ease); }
  .rev-ctrl button:hover { background: #fff; color: var(--blue); border-color: #fff; }

  .rev-track {
    --gap: 18px; --n: 3;
    display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding-inline: var(--pad); scroll-padding-inline: var(--pad);
    scrollbar-width: none; cursor: grab; max-width: 1500px; margin-inline: auto;
  }
  .rev-track::-webkit-scrollbar { display: none; }
  .rev-track.drag { cursor: grabbing; scroll-snap-type: none; scroll-behavior: auto; user-select: none; }
  .rev-card {
    flex: 0 0 calc((100% - var(--gap) * (var(--n) - 1)) / var(--n));
    scroll-snap-align: start; background: var(--cream); color: var(--ink);
    border-radius: 26px; padding: 28px; display: flex; flex-direction: column; min-height: 290px;
  }
  .rev-top { display: flex; align-items: center; gap: 14px; }
  .rev-av { width: 46px; height: 46px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-family: var(--display); font-weight: 800; font-size: 18px; flex: none; }
  .rev-top figcaption { display: flex; flex-direction: column; line-height: 1.3; margin-right: auto; }
  .rev-top strong { font-size: 15.5px; }
  .rev-top span { font-size: 12px; color: var(--mute); }
  .rev-g { color: var(--blue); opacity: 0.8; }
  .rev-note { font-size: 12px; opacity: .65; margin-top: 22px; }
  .rev-card blockquote { font-size: 15.5px; line-height: 1.62; color: #2e2c28; }
  @media (max-width: 1000px) { .rev-track { --n: 2; } }
  @media (max-width: 640px) {
    .rev-track { --n: 1; --gap: 12px; padding-inline: 20px 56px; }
    .rev-meta { text-align: left; } .rev-card { min-height: 0; }
    .rev-title .script { font-size: 1.35em; }
  }
</style>
