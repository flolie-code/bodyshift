---
const pics = [
  { src: '/img/studio-raum.webp', alt: 'Reformer-Raum der Reformbar im Abendlicht', w: 1600, h: 904, wide: true },
  { src: '/img/reformer-klasse.webp', alt: 'Reformer-Pilates-Einheit in der Kleingruppe', w: 1200, h: 1500 },
  { src: '/img/reformer-detail.webp', alt: 'Hände an den Schlaufen eines Reformers', w: 1200, h: 1500 },
  { src: '/img/coaching.webp', alt: 'Trainerin korrigiert die Haltung im 1:1 Coaching', w: 1200, h: 1500 },
  { src: '/img/matten-pilates.webp', alt: 'Seitstütz beim Matten-Pilates auf blauer Matte', w: 1200, h: 1500 },
  { src: '/img/yoga-flow.webp', alt: 'Ruhige Yoga-Einheit im Sonnenlicht', w: 1200, h: 1500 },
  { src: '/img/beckenboden.webp', alt: 'Beckenbodentraining mit Ball auf der Matte', w: 1200, h: 1500 },
  { src: '/img/bodyforming.webp', alt: 'Selbstbewusste Frau im Studio der Reformbar', w: 1200, h: 1500 },
];
---
<section class="gal" aria-labelledby="gal-h" data-gal>
  <div class="wrap gal-head">
    <h2 class="display h2" id="gal-h" data-reveal>Ein<span class="script">blicke</span></h2>
    <p class="lead" data-reveal style="--d:.1s">Warmes Licht, ruhige Farben, königsblaue Akzente – ein Ort, an den man gerne zurückkommt.</p>
  </div>
  <div class="gal-track" data-gal-track tabindex="0" aria-label="Bildergalerie – wischen zum Blättern">
    {pics.map((p, i) => (
      <figure class={`gal-item ${p.wide ? 'wide' : ''} ${i % 2 ? 'low' : ''}`}>
        <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
      </figure>
    ))}
  </div>
</section>

<script>
  // Das Band wandert beim vertikalen Scrollen sanft mit (Desktop) – Wischen bleibt immer möglich.
  const sec = document.querySelector<HTMLElement>('[data-gal]');
  const track = document.querySelector<HTMLElement>('[data-gal-track]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sec && track && !calm) {
    let ticking = false, user = false;
    track.addEventListener('pointerdown', () => (user = true), { passive: true });
    track.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) user = true; }, { passive: true });
    const run = () => {
      ticking = false;
      if (user) return;
      const r = sec.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
      track.scrollLeft = p * (track.scrollWidth - track.clientWidth);
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(run); } }, { passive: true });
    run();
  }
</script>

<style>
  .gal { padding: clamp(64px, 9vw, 120px) 0; overflow: hidden; }
  .gal-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 48px); }
  .gal-head .lead { max-width: 380px; color: var(--mute); }
  .gal-track { display: flex; gap: 18px; align-items: flex-start; overflow-x: auto; padding: 0 var(--pad) 40px; scrollbar-width: none; scroll-snap-type: x proximity; }
  .gal-track::-webkit-scrollbar { display: none; }
  .gal-item { flex: none; width: clamp(220px, 24vw, 340px); aspect-ratio: 4 / 5; border-radius: 999px 999px 26px 26px; overflow: hidden; scroll-snap-align: start; background: var(--sand); }
  .gal-item.wide { width: clamp(320px, 46vw, 680px); aspect-ratio: 16 / 10; border-radius: 26px; }
  .gal-item.low { margin-top: 40px; }
  .gal-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .gal-item:hover img { transform: scale(1.05); }
  @media (max-width: 640px) { .gal-item.low { margin-top: 24px; } .gal-item { width: 64vw; } .gal-item.wide { width: 84vw; } }
</style>
