# BodyShift App — Environment Variables
# Kopiere diese Datei zu .env.local und trage echte Werte ein.
# .env.local wird von git ignoriert und niemals committed.

# Supabase (Auth + Datenbank + Foto-Storage)
# Anlegen auf https://supabase.com — Region "Frankfurt" wählen (EU/DSGVO)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# === Server-Side Secrets — nur für Supabase Edge Functions ===
# Diese Werte NIEMALS im Frontend/App nutzen. Setzen via:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SPOONACULAR_API_KEY=...

# Claude Vision API (KI-Foto-Analyse für Mahlzeiten + Übersetzung der Rezepte)
# Anlegen auf https://console.anthropic.com — API-Key mit sk-ant-... beginnend
ANTHROPIC_API_KEY=sk-ant-...

# Spoonacular Recipe API (Rezept-Import-Quelle)
# Anlegen auf https://spoonacular.com/food-api — Free: 150 requests/day
# Einmalig für Import genutzt, danach nur bei Update
SPOONACULAR_API_KEY=...
